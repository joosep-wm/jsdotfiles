# ============================================================================
# ~/.secrets.zsh  — API keys & tokens. NEVER commit the real file.
#
# Setup:  cp shell/secrets.zsh.example ~/.secrets.zsh   (then fill in values)
# This template lists the variable NAMES the shell expects; values are blank.
# `.secrets.zsh` is gitignored; only this *.example template is tracked.
# ============================================================================

# Gemini API (personal)
export GEMINI_API_KEY=""

# GitHub token used by Claude skills
export SKILL_GITHUB_API_TOKEN=""

# Tomorrow.io weather API (personal)
export WEATHER_API_KEY=""

# Maps.co / geocoding API (personal)
export GEO_API_KEY=""

# Context7 (Gridraven)
export CONTEXT7_API_KEY=""

# Grafana read-only token (Gridraven)
export GRAFANA_TOKEN=""

# Ducklake token
export QUACK_TOKEN=""

# Klaabu token
export KLAABU_TOKEN=""
