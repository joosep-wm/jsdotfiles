# ============================================================================
# ~/.zshrc  (managed by jsdotfiles)
# Portable across macOS and Linux. Mac-only paths live in env.zsh / path.zsh /
# zprofile and are guarded so this file is safe to use on a fresh remote box.
# ============================================================================

# --- Auto-start zellij (MUST be first — before the p10k instant prompt) -----
# A full-screen TUI launched *after* instant prompt activates leaves the
# terminal in a broken raw/alt-screen state (blank screen, keys don't echo).
# So this runs first: the outer shell blocks on zellij and never renders the
# instant prompt. Inner zellij panes re-source this file, hit the $ZELLIJ
# guard, skip the block, and get the normal prompt.
# Guards: interactive + real TTY · zellij installed · not already in zellij ·
#         not an IDE-embedded terminal (VS Code / IntelliJ).
if [[ -o interactive ]] && [[ -t 1 ]] \
   && command -v zellij >/dev/null 2>&1 \
   && [[ -z "$ZELLIJ" ]] \
   && [[ "$TERM_PROGRAM" != "vscode" ]] \
   && [[ -z "$INTELLIJ_ENVIRONMENT_READER" ]]; then
  export ZELLIJ_AUTO_ATTACH=true   # reuse one session; rely on zellij panes, not iTerm2 windows
  export ZELLIJ_AUTO_EXIT=true     # closing zellij closes the terminal window
  eval "$(zellij setup --generate-auto-start zsh)"
fi

# --- Powerlevel10k instant prompt (keep near the top) -----------------------
# Anything that needs console input (passwords, [y/n]) must go ABOVE this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Secrets & environment (sourced only if present) ------------------------
[ -f "$HOME/.secrets.zsh" ] && source "$HOME/.secrets.zsh"   # gitignored, see secrets.zsh.example
[ -f "$HOME/.env.zsh" ]     && source "$HOME/.env.zsh"
[ -f "$HOME/.path.zsh" ]    && source "$HOME/.path.zsh"

# --- Oh My Zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Most tool plugins (docker/gcloud/kubectl/terraform) only add completions/aliases
# and stay quiet when the tool is absent. The fzf and zoxide plugins are the
# exception: they print "[oh-my-zsh] … not found" to the console at load time,
# which — happening after the p10k instant-prompt preamble — trips p10k's
# "console output during zsh initialization" warning. So add those two only when
# the binary is actually present.
plugins=(
  git
  docker
  gcloud
  kubectl
  terraform
  zsh-autosuggestions
  you-should-use
)
command -v fzf    >/dev/null 2>&1 && plugins+=(fzf)
command -v zoxide >/dev/null 2>&1 && plugins+=(zoxide)
# zsh-syntax-highlighting must be sourced last, so append it after everything.
plugins+=(zsh-syntax-highlighting)

if [ -d "$ZSH" ]; then
  source "$ZSH/oh-my-zsh.sh"
else
  # Minimal fallback so a box without oh-my-zsh is still usable.
  # Run `./install.sh --omz` to install the full stack.
  autoload -Uz compinit && compinit
  autoload -Uz colors && colors
  setopt prompt_subst
  PROMPT='%F{green}%n@%m%f %F{blue}%~%f %# '
fi

# --- Tools ------------------------------------------------------------------
[ -f "$HOME/.fzf.zsh" ] && source "$HOME/.fzf.zsh"

# --- Aliases ----------------------------------------------------------------
[ -f "$HOME/.aliases.zsh" ] && source "$HOME/.aliases.zsh"

# --- Editor -----------------------------------------------------------------
export EDITOR="${EDITOR:-vim}"
export VISUAL="$EDITOR"

# --- Powerlevel10k user config ----------------------------------------------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
